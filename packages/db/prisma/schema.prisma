// ─────────────────────────────────────────────────────────────────────────
// V2 — Fluxo linear (Onboarding → Dossiê → Linha Editorial → Aprovação)
// ─────────────────────────────────────────────────────────────────────────

/// Onboarding estruturado do cliente (V2). É o único ponto de coleta manual do
/// operador — todo o resto (pesquisa, dossiê, linha editorial) é IA. Guardado
/// como payload flexível (Json) para o wizard multi-step evoluir sem migração.
model StrategicOnboarding {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  clientId       String    @unique @db.Uuid
  status         String    @default("draft")  // draft | completed
  step           Int       @default(0)        // progresso do wizard (0..N)
  payload        Json      @default("{}")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("strategic_onboardings")
}

/// Snapshot congelado gerado logo após o onboarding: agrega mercado, personas,
/// concorrentes e voz da marca num único documento estratégico. Não é editado
/// manualmente — é a memória de partida da IA para gerar linhas editoriais.
model StrategicDossier {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  clientId       String    @db.Uuid
  version        Int       @default(1)
  status         String    @default("generating")  // generating | ready | failed
  summary        Json      @default("{}")           // snapshot editorial + estratégico
  sources        Json      @default("[]")           // ids dos artefatos derivados
  generatedAt    DateTime?
  createdAt      DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, version])
  @@index([organizationId])
  @@index([clientId])
  @@map("strategic_dossiers")
}

/// Link público tokenizado para o cliente aprovar/pedir ajuste na LINHA
/// EDITORIAL (espelha ReviewLink, mas para EditorialStrategy).
model EditorialReviewLink {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  strategyId     String    @db.Uuid
  token          String    @unique
  status         String    @default("open") // open | decided | revoked
  createdBy      String?   @db.Uuid
  expiresAt      DateTime?
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())

  strategy EditorialStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([strategyId])
  @@map("editorial_review_links")
}

/// Comentário do cliente sobre uma linha editorial (aprovação ou ajuste). O
/// texto do ajuste é dobrado no brief da próxima versão para o agente evoluir
/// a estratégia sem recomeçar.
model EditorialReviewComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  strategyId     String   @db.Uuid
  decision       String              // approve | request_changes
  comment        String?
  authorName     String?
  createdAt      DateTime @default(now())

  strategy EditorialStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
  @@map("editorial_review_comments")
}
