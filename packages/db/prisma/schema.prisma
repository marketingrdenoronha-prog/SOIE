  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([personaId])
  @@map("audience_questions")
}

model SentimentAnalysis {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String   @db.Uuid
  source         String
  sampleSize     Int      @default(0)
  distribution   Json     @default("{}")
  themes         Json     @default("[]")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@map("sentiment_analyses")
}

// ─────────────────────────────────────────────────────────────────────────
// Editorial
// ─────────────────────────────────────────────────────────────────────────

model EditorialStrategy {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  projectId      String     @db.Uuid
  // V2: FK direto ao Client para navegação simplificada (nullable até o
  // seeder V2 backfillar clientes existentes).
  clientId       String?    @db.Uuid
  // V2: versionamento — cada geração é uma nova linha, nunca sobrescrita.
  // `parentStrategyId` traça a linha do tempo V1 → V2 → V3.
  version           Int        @default(1)
  parentStrategyId  String?    @db.Uuid
  positioning       String?
  pillars           Json       @default("[]")
  objectives        Json       @default("{}")
  rationale         String?
  confidence        Confidence @default(medium)
  // Fluxo de aprovação do cliente: draft → pending_client → approved | changes_requested.
  status            String     @default("draft")
  submittedAt       DateTime?
  approvedAt        DateTime?
  changesRequestedAt DateTime?
  // V3 — Esteira de Produção. Cada Linha Editorial (não a peça) é um card no
  // Kanban de Produção. `productionStage` é a coluna da esteira, independente
  // do `status` de aprovação do cliente:
  //   null          → fora da esteira (rascunho ou devolvida ao Editorial)
  //   client_review → Em Revisão do Cliente (após "Enviar para Cliente")
  //   approved      → Aprovada (cliente aprovou)
  //   design        → Designer / Audiovisual (produção das peças)
  //   final_review  → Em Aprovação Final (revisão interna)
  //   to_post       → A Postar (pronto para publicar)
  productionStage   String?
  // Responsável atual pela Linha Editorial na esteira (quem enviou/movimentou).
  responsibleUserId String?    @db.Uuid
  // Timeline append-only de movimentações. Nunca é apagada.
  // [{ from, to, at, byId, byName, note }]
  stageHistory      Json       @default("[]")
  createdAt         DateTime   @default(now())

  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editorialLines  EditorialLine[]
  reviewLinks     EditorialReviewLink[]
  reviewComments  EditorialReviewComment[]

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@map("editorial_strategies")
}

model EditorialLine {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  strategyId     String             @db.Uuid
  name           String
  objective      EditorialObjective
  funnelStage    FunnelStage
  platforms      Json               @default("[]")

  strategy   EditorialStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  categories Category[]

  @@index([organizationId])
  @@index([strategyId])
  @@map("editorial_lines")
}

model Category {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @db.Uuid
  editorialLineId String  @db.Uuid
  name            String
  description     String?
  parentId        String? @db.Uuid

  editorialLine EditorialLine @relation(fields: [editorialLineId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]    @relation("CategoryTree")
  themes        Theme[]

  @@index([organizationId])
  @@index([editorialLineId])
  @@map("categories")
}

model Theme {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  categoryId     String  @db.Uuid
  title          String
  angle          String?
  microthemes    Json    @default("[]")
  priority       Int     @default(0)
  // V2: canal e formato pré-atribuídos ao tema durante a geração da linha
  // editorial — o operador não precisa reescolher no momento da produção.
  channel        String?
  format         String?
  // V2/V3: copy pronta para produção do tema, no documento que vai para o
  // cliente aprovar. V3 padroniza como um objeto estruturado por formato
  // (vídeo/motion: duração + seções Gancho/Conexão/Desenvolvimento/Virada/CTA;
  // carrossel: slides; estático: headline/subheadline/corpo/cta/designNotes).
  // Formas legadas (string ou array de strings) continuam sendo renderizadas.
  copy           Json?
  // V3 — campos padrão de saída (OUTPUT PADRÃO): cada conteúdo sai pronto para
  // produção, sem depender de um Social Media escrever a copy depois.
  strategicObjective String?
  hook               String?
  cta                String?
  productionNotes    String?
  // FK inversa: quando a produção automática cria um Deliverable para este
  // tema, guarda o id para evitar duplicação e permitir navegação. @unique
  // porque cada tema gera no máximo 1 peça (a produção reusa se re-clicada).
  deliverableId  String? @unique @db.Uuid

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contentIdeas ContentIdea[]
  deliverable  Deliverable?  @relation("ThemeDeliverable", fields: [deliverableId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([categoryId])
  @@index([deliverableId])
  @@map("themes")
}

model ContentIdea {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String   @db.Uuid
  themeId        String?  @db.Uuid
  title          String
  format         String?
  funnelStage    FunnelStage?
  objective      EditorialObjective?
  rationale      String?
  status         String   @default("suggested")
  score          Json     @default("{}")
  createdBy      String   @default("ai")
  createdAt      DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  theme    Theme?    @relation(fields: [themeId], references: [id], onDelete: SetNull)
  contents Content[]

  @@index([organizationId])
  @@index([projectId])
  @@map("content_ideas")
}

model Content {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  projectId      String        @db.Uuid
  ideaId         String?       @db.Uuid
  title          String
  platform       String?
  format         String?
  status         ContentStatus @default(draft)
  body           Json          @default("{}")
  briefing       Json          @default("{}")
  createdBy      String?       @db.Uuid
  assignedTo     String?       @db.Uuid
  version        Int           @default(1)
  createdAt      DateTime      @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idea    ContentIdea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  posts   Post[]
  copies  Copy[]

  @@index([organizationId])
  @@index([projectId])
  @@map("contents")
}

model Post {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  contentId      String        @db.Uuid
  platform       String
  scheduledFor   DateTime?
  publishedAt    DateTime?
  externalRef    String?
  status         ContentStatus @default(draft)
  metrics        Json          @default("{}")

  content        Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  calendarEntries CalendarEntry[]

  @@index([organizationId])
  @@index([contentId])
  @@map("posts")
}

model Copy {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @db.Uuid
  contentId       String? @db.Uuid
  projectId       String  @db.Uuid
  kind            String
  text            String
  frameworkId     String? @db.Uuid
  hookId          String? @db.Uuid
  variantLabel    String?
  score           Json    @default("{}")
  aiExecutionId   String? @db.Uuid

  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@map("copies")
