// SOIE — Prisma schema (Architecture Phase 2)
//
// Multi-tenancy: every business table carries `organizationId` as an indexed
// scalar. It is intentionally NOT modeled as a Prisma relation to Organization
// — with dozens of tenant tables that would force an unwieldy back-relation
// list on Organization and cascade semantics we handle explicitly per tenant.
// Isolation is enforced at two layers regardless: the repository layer always
// scopes by organizationId, and Postgres Row-Level Security (added via SQL
// migration) is the backstop. Meaningful parent/child links (client → brand →
// project → …) ARE modeled as relations.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Kept only for local dev / CI where the Node client falls back to the
  // engine binary. On Vercel the Neon serverless driver adapter is used,
  // which bypasses the engine entirely (see packages/db/src/client.ts).
  binaryTargets   = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum OrgStatus {
  active
  suspended
  trialing
}

enum MembershipStatus {
  active
  invited
  disabled
}

enum ProjectStatus {
  onboarding
  research
  strategy
  production
  review
  done
  archived
}

enum Confidence {
  high
  medium
  low
}

enum ResearchType {
  market
  competitor
  trend
  audience
  full
}

enum FunnelStage {
  tofu
  mofu
  bofu
}

enum EditorialObjective {
  authority
  trust
  educate
  reduce_objection
  attract
  identify
  position
  desire
  relationship
  convert
}

enum ContentStatus {
  draft
  in_review
  approved
  published
  archived
}

enum ApprovalStatus {
  pending
  approved
  changes_requested
  rejected
}

enum AIProvider {
  openai
  anthropic
  gemini
  deepseek
}

enum ExecutionStatus {
  success
  error
  fallback
}

enum OrchestrationStatus {
  queued
  running
  succeeded
  failed
  partial
}

enum MemoryScope {
  org
  client
  brand
  project
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum DeliverableStatus {
  queued
  generating
  draft
  internal_review
  client_review
  approved
  changes_requested
  delivered
}

enum ReviewDecision {
  approve
  request_changes
}

// ─────────────────────────────────────────────────────────────────────────
// Identity & Access
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  status       OrgStatus @default(trialing)
  billingEmail String?
  byokEnabled  Boolean   @default(false)
  settings     Json      @default("{}")
  planId       String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships   Membership[]
  roles         Role[]
  subscriptions Subscription[]

  @@map("organizations")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  avatarUrl    String?
  mfaSecret    String?
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleId         String           @db.Uuid
  status         MembershipStatus @default(invited)
  scope          Json             @default("{}")
  invitedBy      String?          @db.Uuid
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  name           String
  isSystem       Boolean  @default(false)
  permissions    Json     @default("[]")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([organizationId])
  @@map("roles")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  keyHash        String
  prefix         String
  scopes         Json      @default("[]")
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdBy      String?   @db.Uuid
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@map("api_keys")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  organizationId   String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Client Management
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  name             String
  industry         String?
  website          String?
  logoUrl          String?
  status           String    @default("active")
  tags             Json      @default("[]")
  // V2: FK opcional para a EditorialStrategy aprovada corrente. Nullable até
  // o cliente aprovar sua primeira linha editorial.
  activeStrategyId String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  brands    Brand[]
  briefings Briefing[]
  onboarding StrategicOnboarding?
  dossiers  StrategicDossier[]

  @@index([organizationId])
  @@map("clients")
}

model Brand {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  clientId         String   @db.Uuid
  name             String
  positioning      String?
  valueProposition String?
  products         Json     @default("[]")
  objectives       Json     @default("[]")
  icp              Json     @default("{}")
  createdAt        DateTime @default(now())

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects    Project[]
  brandVoices BrandVoice[]
  vocabularies Vocabulary[]
  archetypes  Archetype[]

  @@index([organizationId])
  @@index([clientId])
  @@map("brands")
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  brandId          String        @db.Uuid
  name             String
  goal             String?
  status           ProjectStatus @default(onboarding)
  funnelStageFocus FunnelStage?
  platforms        Json          @default("[]")
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime      @default(now())

  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  researches         Research[]
  personas           Persona[]
  editorialStrategies EditorialStrategy[]
  calendars          Calendar[]
  contents           Content[]
  contentIdeas       ContentIdea[]
  orchestrationRuns  OrchestrationRun[]
  deliverables       Deliverable[]

  @@index([organizationId])
  @@index([brandId])
  @@map("projects")
}

model Briefing {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  clientId       String   @db.Uuid
  projectId      String?  @db.Uuid
  payload        Json     @default("{}")
  source         String   @default("form")
  status         String   @default("draft")
  createdBy      String?  @db.Uuid
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@map("briefings")
}

model File {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  clientId       String?  @db.Uuid
  projectId      String?  @db.Uuid
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  checksum       String?
  uploadedBy     String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("files")
}

model Upload {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  fileId         String?  @db.Uuid
  status         String   @default("pending")
  parseResult    Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("uploads")
}

// ─────────────────────────────────────────────────────────────────────────
// Brand DNA
// ─────────────────────────────────────────────────────────────────────────

model BrandVoice {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  brandId        String     @db.Uuid
  tone           Json       @default("{}")
  formality      String?
  emojisPolicy   Json       @default("{}")
  doList         Json       @default("[]")
  dontList       Json       @default("[]")
  examples       Json       @default("[]")
  confidence     Confidence @default(medium)
  createdAt      DateTime   @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
  @@map("brand_voices")
}

model Vocabulary {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  brandId        String @db.Uuid
  kind           String
  term           String
  note           String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
  @@map("vocabularies")
}

model Archetype {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  brandId        String @db.Uuid
  archetype      String
  weight         Float  @default(0)
  rationale      String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
  @@map("archetypes")
}

// ─────────────────────────────────────────────────────────────────────────
// Market Intelligence
// ─────────────────────────────────────────────────────────────────────────

model Research {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  projectId          String       @db.Uuid
  type               ResearchType
  status             String       @default("queued")
  params             Json         @default("{}")
  summary            Json         @default("{}")
  confidence         Confidence   @default(low)
  orchestrationRunId String?      @db.Uuid
  createdBy          String?      @db.Uuid
  createdAt          DateTime     @default(now())

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitors    Competitor[]
  marketAnalyses MarketAnalysis[]

  @@index([organizationId])
  @@index([projectId])
  @@map("researches")
}

model Competitor {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  projectId      String  @db.Uuid
  researchId     String? @db.Uuid
  name           String
  url            String?
  positioning    String?
  strengths      Json    @default("[]")
  weaknesses     Json    @default("[]")
  contentStrategy Json   @default("{}")
  metrics        Json    @default("{}")
  source         String  @default("ai")

  research Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@map("competitors")
}

model MarketAnalysis {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  projectId      String     @db.Uuid
  researchId     String?    @db.Uuid
  swot           Json       @default("{}")
  trends         Json       @default("[]")
  opportunities  Json       @default("[]")
  threats        Json       @default("[]")
  confidence     Confidence @default(medium)
  createdAt      DateTime   @default(now())

  research Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@map("market_analyses")
}

model Trend {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String?  @db.Uuid
  source         String
