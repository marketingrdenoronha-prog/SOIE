# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3333
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3333

# ─── Database (PostgreSQL 16 + pgvector) ─────────────────────────────────
DATABASE_URL=postgresql://soie:soie@localhost:5432/soie?schema=public

# ─── Redis (cache + BullMQ) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Access token lifetime in seconds. There is no refresh-token flow yet, so keep
# this long enough to avoid logging users out mid-use (default: 30 days).
JWT_ACCESS_TTL=2592000
JWT_REFRESH_TTL=2592000

# ─── Secrets encryption (envelope) ───────────────────────────────────────
SECRETS_MASTER_KEY=base64:change-me-32-bytes

# ─── AI providers (platform keys; tenants may BYOK) ──────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Object storage (S3 / R2) ────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=soie
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Billing ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
